{
  "name": "@kris-holy/openclaw-keln-provider",
  "version": "1.0.0",
  "description": "Keln as an OpenClaw model provider, with open models through an OpenAI-compatible API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kris-holy/openclaw-keln-provider"
  },
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.1"
  },
  "devDependencies": {
    "openclaw": "2026.11.1",
    "typescript": "5.9.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "keln"
    ],
    "compat": {
      "pluginApi": ">=2026.11.1",
      "minGatewayVersion": "2026.11.1"
    },
    "build": {
      "openclawVersion": "2026.11.1",
      "pluginSdkVersion": "2026.11.1"
    }
  }
}
